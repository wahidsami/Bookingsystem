# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=rifah_shared
DB_HOST=localhost
DB_PORT=5434

# Server Configuration
PORT=5000
NODE_ENV=development
TRUST_PROXY=1
JSON_BODY_LIMIT=1mb
SERVER_PUBLIC_URL=http://localhost:5000

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-32-characters-long
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security / bootstrap controls
ENABLE_DIAGNOSTIC_ROUTES=false
ENABLE_DEFAULT_SUPER_ADMIN=false
DEFAULT_SUPER_ADMIN_EMAIL=
DEFAULT_SUPER_ADMIN_PASSWORD=

# Email Configuration - Resend (used for tenant approval, welcome, rejection emails)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Rifah Platform <onboarding@yourdomain.com>
# Optional: tenant dashboard base URL used in approval/payment links and emails
TENANT_DASHBOARD_BASE_URL=https://tenant.yourdomain.com
# Optional: explicit login URL override
# TENANT_DASHBOARD_LOGIN_URL=https://tenant.yourdomain.com/ar/login
# Optional: staff app/login reference used in staff invite and password reset emails
# STAFF_APP_URL=https://staff.yourdomain.com
# STAFF_APP_LOGIN_URL=https://staff.yourdomain.com/login
# Optional: separate payment/subscription link in approval email. If unset, same as TENANT_DASHBOARD_URL
# TENANT_PAYMENT_LINK_URL=https://pay.yourdomain.com/...

# API Keys (optional)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
OPENAI_API_KEY=

# Logging
LOG_LEVEL=info

# Optional rate limit overrides
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_AUTH_MAX=50
RATE_LIMIT_PASSWORD_RESET_MAX=3
RATE_LIMIT_PAYMENT_MAX=10
RATE_LIMIT_EMAIL_VERIFICATION_MAX=5
RATE_LIMIT_PHONE_VERIFICATION_MAX=5
RATE_LIMIT_UPLOAD_MAX=20
